# Copy to .env and adjust as needed. Defaults already match docker-compose, so a .env is optional
# for local development. This file is read by BOTH docker compose (POSTGRES_*) and the app (SHAMELA_*).

# --- docker compose (container credentials / ports) ---
POSTGRES_USER=shamela
POSTGRES_PASSWORD=shamela
POSTGRES_DB=shamela_rag
POSTGRES_PORT=5433
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# --- application (shamela_rag.config.Settings) ---
SHAMELA_POSTGRES_HOST=localhost
SHAMELA_POSTGRES_PORT=5433
SHAMELA_POSTGRES_USER=shamela
SHAMELA_POSTGRES_PASSWORD=shamela
SHAMELA_POSTGRES_DB=shamela_rag
SHAMELA_QDRANT_URL=http://localhost:6333
SHAMELA_QDRANT_COLLECTION=shamela_general
SHAMELA_DENSE_EMBEDDING_MODEL=BAAI/bge-m3
SHAMELA_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Absolute path to the extracted Shamela4 corpus root
SHAMELA_CORPUS_ROOT=.
# Root-expansion sparse field (off by default)
SHAMELA_ROOT_EXPANSION_ENABLED=false
SHAMELA_ROOT_EXPANSION_WEIGHT=0.25
SHAMELA_ROOT_DICTIONARY_PATH=_meta/root_dictionary.jsonl
SHAMELA_ROOT_EXPANSION_STATE_PATH=root_expansion_state.json

# Local generation (default memory = in-memory stub). See runbook section 7.
SHAMELA_LLM_BACKEND=memory
# SHAMELA_LLM_OLLAMA_MODEL=qwen2.5:3b
# SHAMELA_LLM_GGUF_PATH=D:\models\Qwen2.5-7B-Instruct-Q4_K_M.gguf

# Hosted OpenAI-compatible generation API (Together.ai, DeepSeek, DashScope, ...).
# SHAMELA_LLM_BACKEND=openai_compatible
# SHAMELA_LLM_API_BASE_URL=https://api.together.xyz/v1
# SHAMELA_LLM_API_KEY=
# SHAMELA_LLM_API_MODEL=Qwen/Qwen3.5-9B

# OpenRouter dense embeddings (optional hosted backend). Set SHAMELA_QDRANT_DENSE_DIM=4096 for
# qwen3, or leave at 1024 for bge-m3 — must match whichever model you ingest with.
# SHAMELA_EMBEDDING_BACKEND=openrouter
# SHAMELA_EMBEDDING_API_BASE_URL=https://openrouter.ai/api/v1
# SHAMELA_EMBEDDING_API_KEY=
